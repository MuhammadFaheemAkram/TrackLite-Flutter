    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"seq\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"id\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"timestamp\" TEXT NOT NULL, \"user_id\" TEXT NULL, \"anonymous_id\" TEXT NOT NULL, \"properties\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" TEXT NULL, \"claim_token\" TEXT NULL, \"claimed_at\" TEXT NULL, \"sent_at\" TEXT NULL, \"last_error\" TEXT NULL, CHECK (length(trim(id)) > 0), CHECK (length(trim(name)) > 0), CHECK (status IN ('pending', 'sending', 'sent', 'failed')), CHECK (attempts >= 0), CHECK (json_type(properties) = 'object'), CHECK (\"timestamp\" GLOB '*Z'), CHECK (next_attempt_at IS NULL OR next_attempt_at GLOB '*Z'), CHECK (claimed_at IS NULL OR claimed_at GLOB '*Z'), CHECK (sent_at IS NULL OR sent_at GLOB '*Z'), CHECK ((status = 'sending') = (claim_token IS NOT NULL AND claimed_at IS NOT NULL)), CHECK ((status = 'sent') = (sent_at IS NOT NULL)));"
        }
      ]
