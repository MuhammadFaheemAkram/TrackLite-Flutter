        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"uploads\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"trigger\" TEXT NOT NULL, \"started_at\" TEXT NOT NULL, \"finished_at\" TEXT NOT NULL, \"outcome\" TEXT NOT NULL, \"batches\" INTEGER NOT NULL DEFAULT 0, \"events\" INTEGER NOT NULL DEFAULT 0, \"error\" TEXT NULL, CHECK (outcome IN ('uploaded', 'nothing', 'offline', 'failed', 'unauthorized')), CHECK (batches >= 0 AND events >= 0), CHECK (started_at GLOB '*Z' AND finished_at GLOB '*Z'));"
        }
      ]
